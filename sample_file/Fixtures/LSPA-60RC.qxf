<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE FixtureDefinition>
<FixtureDefinition xmlns="http://www.qlcplus.org/FixtureDefinition">
 <Creator>
  <Name>Q Light Controller Plus</Name>
  <Version>5.2.2</Version>
  <Author>JMSSUU</Author>
 </Creator>
 <Manufacturer>LSPA</Manufacturer>
 <Model>60RC</Model>
 <Type>Color Changer</Type>
 <Channel Name="total dimming" Preset="IntensityDimmer"/>
 <Channel Name="Red" Preset="IntensityRed"/>
 <Channel Name="Green" Preset="IntensityGreen"/>
 <Channel Name="Blue" Preset="IntensityBlue"/>
 <Channel Name="Function">
  <Group Byte="0">Colour</Group>
  <Capability Min="0" Max="10">None</Capability>
  <Capability Min="11" Max="60">Program color selection</Capability>
  <Capability Min="61" Max="110">Jump</Capability>
  <Capability Min="111" Max="160">Gradual change</Capability>
  <Capability Min="161" Max="210">Pluse change</Capability>
  <Capability Min="251" Max="255">Voice control</Capability>
 </Channel>
 <Channel Name="Speed">
  <Group Byte="0">Speed</Group>
  <Capability Min="0" Max="255">Speed(color, voice)</Capability>
 </Channel>
 <Channel Name="Stroboscopic">
  <Group Byte="0">Effect</Group>
  <Capability Min="0" Max="255">Stroboscopic slow to fast</Capability>
 </Channel>
 <Mode Name="mode1">
  <Channel Number="0">total dimming</Channel>
  <Channel Number="1">Red</Channel>
  <Channel Number="2">Green</Channel>
  <Channel Number="3">Blue</Channel>
  <Channel Number="4">Stroboscopic</Channel>
  <Channel Number="5">Function</Channel>
  <Channel Number="6" ActsOn="5">Speed</Channel>
  <Head>
   <Channel>0</Channel>
   <Channel>1</Channel>
   <Channel>2</Channel>
   <Channel>3</Channel>
   <Channel>4</Channel>
   <Channel>5</Channel>
   <Channel>6</Channel>
  </Head>
 </Mode>
 <Physical>
  <Bulb Type="LED" Lumens="300" ColourTemperature="4"/>
  <Dimensions Weight="0.73" Width="206" Height="216" Depth="70"/>
  <Lens Name="Other" DegreesMin="30" DegreesMax="100"/>
  <Focus Type="Fixed" PanMax="90" TiltMax="180"/>
  <Technical PowerConsumption="60" DmxConnector="3-pin"/>
 </Physical>
</FixtureDefinition>
